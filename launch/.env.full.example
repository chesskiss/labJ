# Copy this file to launch/.env.full and fill keys.
# Windows launcher (Start LabJ.bat) can create this for you.

# Optional LLM keys
LLM_API_KEY=
GROQ_API_KEY=

# App ports on host
UI_PORT=5173
ORCHESTRATION_API_PORT=8000
JOURNAL_API_PORT=8002
STT_PORT=8001

# DB location (inside containers)
DATABASE_URL=sqlite+pysqlite:////app/data/journal.sqlite

# Optional CORS overrides
ORCHESTRATION_API_CORS_ORIGINS=*
JOURNAL_API_CORS_ORIGINS=*

# UI build-time API paths
VITE_JOURNAL_API_URL=/api/journal
VITE_ORCHESTRATION_API_URL=/api/orch
VITE_STT_API_URL=http://stt:8000
VITE_JOURNAL_API_DEBUG=false

# Orchestrator STT URL (container-to-container)
STT_API_URL=http://stt:8000/transcribe
