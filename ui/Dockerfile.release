FROM node:20-alpine AS build

WORKDIR /app/ui

COPY ui/package.json ui/package-lock.json ./
RUN npm ci

COPY ui ./

ARG VITE_JOURNAL_API_URL=/api/journal
ARG VITE_JOURNAL_API_DEBUG=false
ARG VITE_ORCHESTRATION_API_URL=/api/orch
ARG VITE_STT_API_URL=http://stt:8000

ENV VITE_JOURNAL_API_URL=$VITE_JOURNAL_API_URL
ENV VITE_JOURNAL_API_DEBUG=$VITE_JOURNAL_API_DEBUG
ENV VITE_ORCHESTRATION_API_URL=$VITE_ORCHESTRATION_API_URL
ENV VITE_STT_API_URL=$VITE_STT_API_URL

RUN npm run build

FROM nginx:1.27-alpine

COPY launch/nginx.ui.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/ui/dist /usr/share/nginx/html

EXPOSE 80

